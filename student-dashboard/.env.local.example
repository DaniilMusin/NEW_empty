# Perplexity API Key
# Получите ключ на https://www.perplexity.ai/settings/api
PERPLEXITY_API_KEY=your_api_key_here

# Supabase Configuration
# Создайте проект на https://supabase.com
# URL и Anon Key можно найти в Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
# Service Role Key нужен для Admin API (Settings > API > service_role secret)
# ВАЖНО: Храните его в секрете! Он дает полный доступ к базе данных
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Пароль для админ-панели (используйте сложный пароль!)
ADMIN_PASSWORD=change_this_password
